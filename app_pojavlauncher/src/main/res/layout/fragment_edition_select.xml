<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_app">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEVEN"
            android:textColor="@color/primary_text"
            android:textSize="38sp"
            android:textStyle="bold"
            android:letterSpacing="0.16" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="34dp"
            android:text="CHOOSE YOUR EDITION"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:letterSpacing="0.18" />
        <Button
            android:id="@+id/edition_java_button"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/seven_mode_card"
            android:gravity="center"
            android:text="JAVA EDITION"
            android:textAllCaps="false"
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/edition_bedrock_button"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/seven_mode_card"
            android:gravity="center"
            android:text="BEDROCK EDITION"
            android:textAllCaps="false"
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="One launcher. Two editions."
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>