<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEVEN / BEDROCK"
            android:textColor="@color/primary_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:id="@+id/bedrock_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Checking Minecraft Bedrock..."
            android:textColor="@color/secondary_text"
            android:textSize="15sp" />
        <Button
            android:id="@+id/bedrock_launch_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/seven_mode_card"
            android:text="OPEN MINECRAFT"
            android:textAllCaps="false"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/bedrock_import_addon_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="IMPORT ADD-ON (.MCPACK)"
            android:textAllCaps="false" />
        <Button
            android:id="@+id/bedrock_import_world_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="IMPORT WORLD (.MCWORLD)"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Import add-ons and worlds through the official Minecraft import flow. Graphics settings and game updates remain managed by Minecraft / the app store."
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />
        <Button
            android:id="@+id/bedrock_back_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="BACK TO EDITIONS"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>